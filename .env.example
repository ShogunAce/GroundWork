LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
MCP_URL=http://127.0.0.1:3001/mcp
# Optional server-to-server bearer token; must be identical for web and MCP.
MCP_TOKEN=
ALLOW_ANTHROPIC_FALLBACK=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to the deployed HTTPS origin.
PUBLIC_ORIGIN=
