{
  "name": "groundwork",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k \"tsx server/index.ts\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "concurrently -k \"tsx server/index.ts\" \"npm run start -w web\"",
    "verify:mcp": "tsx scripts/verify-mcp.ts",
    "verify:workbook": "tsx scripts/verify-workbook.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@aws-sdk/client-comprehend": "3.1156.0",
    "@aws-sdk/client-polly": "3.1156.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "gsap": "3.15.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
